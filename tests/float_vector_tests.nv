// float_vector_tests.nv — the float formatter against CPython.
//
// WHERE THE EXPECTED STRINGS COME FROM
//
// `repr(x)` in CPython 3, which is the shortest decimal that reads back
// as `x` — the same claim `real.shortest_into` makes.  CPython's
// spelling is not this package's (`1e+23` against `1e23`,
// `100000.0` against `100000`), so the generator re-laid the digits
// CPython chose into this package's own form; what is being compared
// is therefore the DIGITS and the exponent, which is where a shortest
// formatter is right or wrong, and not the punctuation.
//
// The fixed-decimal expectations are `"%.*f" % (dec, x)`, which is
// CPython's own correctly-rounded fixed conversion.
//
// The decomposition expectations are `math.frexp`, scaled to the
// 53-bit significand `real.significand` promises.
//
// The corpus holds the cases a shortest formatter is classically wrong
// on — 0.1, 0.3, 1e23, the smallest subnormal, both ends of the normal
// range, `2^53` and its neighbour — plus every power of two from
// `2^-30` to `2^30` with the double either side of it, plus 280 values
// drawn from uniform 64-bit patterns and everyday magnitudes on a
// fixed seed.

use std.test
use real
use numstr

@test
fn test_shortest_against_cpython_repr_1() [io]
    let vals = [0.1, 0.2, 0.3, 0.7, 0.3333333333333333,
                0.6666666666666666, 1.0e+23, 1.0e-23, 4.94065645841247e-324, 1.0e+308,
                1.7976931348623157e+308, 2.2250738585072014e-308,
                2.225073858507201e-308, 9007199254740992.0,
